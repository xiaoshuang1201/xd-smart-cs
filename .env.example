# ========== 部署模式 ==========
# slim  = 精简模式: PG + Redis + Nest.js + DeepSeek直调 (适合2核4GB)
# full  = 完整模式: 全部基础设施 (需要8GB+)
DEPLOY_MODE=full

# ========== 应用 ==========
NODE_ENV=development
APP_PORT=3100
APP_GLOBAL_PREFIX=api

# ========== 数据库 ==========
DATABASE_URL=postgresql://xd_user:xd_pass@localhost:5432/xd_smart_cs

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== MinIO ==========
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs

# ========== Dify ==========
DIFY_API_URL=http://localhost:5001/v1
DIFY_API_KEY=dify-api-key-here
DIFY_TIMEOUT=30000

# ========== DeepSeek ==========
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========== BGE Embedding (本地) ==========
BGE_EMBEDDING_URL=http://localhost:8000
BGE_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ========== Milvus ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ========== 限流 ==========
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=30

# ========== 生产环境额外变量 ==========
DB_USER=xd_user
DB_PASSWORD=xd_pass
DIFY_SECRET_KEY=xd-dify-secret-key-change-in-production
NUXT_PUBLIC_API_BASE=http://localhost:3100/api/v1
